#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Runs a LinuxCNC command from the run-in-place build: `linuxcnc ...`, `rs274 ...` or
# `halcmd ...` (the image links this script under those names).
set +u
# shellcheck disable=SC1091
. "${LINUXCNC_RIP:-/opt/linuxcnc}/scripts/rip-environment"
set -u
tool="$(basename "$0")"
case "$tool" in
  linuxcnc) exec "${LINUXCNC_RIP:-/opt/linuxcnc}/scripts/linuxcnc" "$@" ;;
  *) exec "$tool" "$@" ;;
esac

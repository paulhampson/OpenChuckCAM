# Test data is compared byte for byte and by content hash, so Git must never
# convert its line endings (a Windows checkout with core.autocrlf would).
testdata/** -text
# Model files are hashed (PRJ-02) wherever they live, test fixtures included.
*.stl -text
# Post definitions are compared byte for byte and the loader normalises newlines to LF,
# but a CRLF checkout must not change the files that are reviewed (decision record 0019 item 6).
posts/** -text
*.step -text
# Append-only registers: a local merge keeps the rows added on both sides instead of stopping
# on a conflict (decision record 0054). Put new rows in number order and check any row you edited.
docs/decisions/README.md merge=union
docs/open-items.md merge=union

# Bundled fonts are unmodified binaries (OFL-1.1); Git must never touch them.
*.ttf binary
